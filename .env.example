# Envoi des demandes de réservation (src/lib/reservation.ts).
# Ces trois variables sont lues côté serveur uniquement — ne pas les préfixer
# par VITE_, ce préfixe exposerait la clé dans le bundle client.
#
# Sans elles, le formulaire affiche une erreur explicite et renvoie vers le
# téléphone : il ne fait jamais croire à une réservation enregistrée.

# Clé API Resend — https://resend.com/api-keys
RESEND_API_KEY=

# Boîte qui reçoit les demandes de réservation
RESERVATION_TO_EMAIL=contact@exemple.fr

# Expéditeur, sur un domaine vérifié dans Resend
RESERVATION_FROM_EMAIL=reservations@exemple.fr

# Adresse publique du site, sans barre oblique finale.
# Necessaire pour l'image de partage sur les reseaux sociaux : leurs robots
# exigent une URL absolue. Sans elle, l'URL produite reste relative et
# l'apercu peut ne pas s'afficher.
VITE_SITE_URL=https://exemple.vercel.app
